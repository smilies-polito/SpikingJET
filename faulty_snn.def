Bootstrap: docker
From: ubuntu:22.04

# Everything SpikingJET needs: campaigns, BER sweeps, hardware fault model, training (incl. DCLS
# for SHD_DELAY), tests and dataset download.
#
#   build:  singularity build --fakeroot faulty_snn.sif faulty_snn.def     (or: sudo singularity build ...)
#   use:    singularity exec --nv faulty_snn.sif python3 main.py -n SHD_DELAY --use-cuda
#           singularity shell --nv faulty_snn.sif                          (then run the README commands)
#   check:  singularity test --nv faulty_snn.sif
#
# Run it from the repository root: the repo, ./data and ./output are reached through the bind of
# the current directory. The GPU driver comes from the host (--nv); the CUDA 11.8 runtime is
# bundled with the PyTorch wheel (any driver >= 520 works).

%labels
    Name SpikingJET
    Description Fault injection for spiking and conventional neural networks

%environment
    export LC_ALL=C.UTF-8 LANG=C.UTF-8
    # never mix in packages from the host's ~/.local (they would shadow the pinned versions below)
    export PYTHONNOUSERSITE=1
    # deterministic cuBLAS (main.py enables torch.use_deterministic_algorithms)
    export CUBLAS_WORKSPACE_CONFIG=:4096:8
    export MPLBACKEND=Agg

%post
    export DEBIAN_FRONTEND=noninteractive PYTHONNOUSERSITE=1 PIP_NO_CACHE_DIR=1
    apt-get update
    apt-get install -y --no-install-recommends python3 python3-pip python3-dev git ca-certificates
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --upgrade pip

    # PyTorch with its CUDA 11.8 runtime
    python3 -m pip install torch==2.0.1 torchvision==0.15.2 --index-url https://download.pytorch.org/whl/cu118

    # SNN libraries and scientific stack (versions tested together)
    python3 -m pip install \
        snntorch==0.9.1 tonic==1.4.3 \
        numpy==1.24.4 pandas==2.2.0 scipy==1.12.0 matplotlib==3.8.2 h5py==3.10.0 \
        tqdm==4.64.1 tomli==2.0.1 pytest==8.2.0

    # DCLS (learnable delays, training of SHD_DELAY only). --no-deps: it would otherwise replace torch.
    # Its import name is DCLS (capitals).
    python3 -m pip install --no-deps dcls==0.1.1

%test
    export PYTHONNOUSERSITE=1
    python3 - <<'EOF'
import torch, torchvision, snntorch, tonic, numpy, pandas, scipy, matplotlib, h5py, tqdm, tomli, pytest
from DCLS.construct.modules import Dcls1d
print(f"torch {torch.__version__} (CUDA available: {torch.cuda.is_available()}), "
      f"snntorch {snntorch.__version__}, tonic {tonic.__version__}, DCLS ok")
EOF

%runscript
    exec python3 "$@"

%help
    SpikingJET container. From the repository root:
        singularity exec --nv faulty_snn.sif python3 download_datasets.py
        singularity exec --nv faulty_snn.sif python3 main.py -n SHD_DELAY --use-cuda
        singularity run  --nv faulty_snn.sif selftest.py
